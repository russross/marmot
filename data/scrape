def report_missing(context, code):
    message = f'{context} references missing college course {code}'
    if (context, code) in known_missing:
        warnings.add(message)
    else:
        unresolved.add(message)

# A missing catalog link can leave a college course code as plain text. Report
# references outside the scraped catalog rather than silently dropping them.
for name, data in sorted(courses.items()):
    for kind in ('pre_section', 'co_section'):
        for prefix, number in COURSE_CODE_RE.findall(pq(data[kind]).text()):
            code = f'{prefix.upper()} {number.upper()}'
            if prefix.upper() in prefixes and code not in courses:
                report_missing(name, code)

def filter_courses(lst, context):
    filtered = []
    prefix = ''
    for elt in lst:
        if elt in filtered:
            continue
        if ' ' in elt:
            prefix = elt[:elt.index(' ')]
        if elt in courses:
            filtered.append(elt)
        elif f'{prefix} {elt}' in courses:
            filtered.append(f'{prefix} {elt}')
        else:
            if prefix in prefixes:
                report_missing(context, elt if ' ' in elt else f'{prefix} {elt}')

    return filtered

