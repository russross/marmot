def filter_courses(lst, context):
    filtered = []
    prefix = ''
    for elt in lst:
        if elt in filtered:
            continue
        if ' ' in elt:
            prefix = elt[:elt.index(' ')]
        if elt in courses:
            filtered.append(elt)
        elif f'{prefix} {elt}' in courses:
            filtered.append(f'{prefix} {elt}')
        else:
            if prefix in prefixes:
                print(f'    course {repr(elt)} not found for course {context}')

    return filtered

