@dataclass(frozen=True)
class CreditHours:
    minimum: Decimal
    maximum: Decimal

    @classmethod
    def parse(cls, text: str) -> 'CreditHours':
        match = re.fullmatch(r'(\d+(?:\.\d+)?)(?:-(\d+(?:\.\d+)?))? Hours?\.', text)
        if match is None:
            raise ValueError(f'unrecognized credit hours: {text!r}')

        minimum = Decimal(match.group(1))
        maximum = Decimal(match.group(2) or match.group(1))
        if minimum > maximum:
            raise ValueError(f'credit-hour range is reversed: {text!r}')

        return cls(minimum, maximum)

    def __str__(self) -> str:
        if self.minimum == self.maximum:
            return f'{self.minimum} credit {"hour" if self.minimum == 1 else "hours"}'
        return f'{self.minimum}-{self.maximum} credit hours'

    def arguments(self) -> str:
        return f'{self.minimum}, {self.maximum}'

