#!/usr/bin/env python3

import os
import subprocess
from sqlite3 import IntegrityError

import courses
import biology
import biology_faculty
import biotechnology_faculty
import chemistry
import chemistry_faculty
import computing
import computingfaculty
import engineering
import engineering_faculty
import earth_sciences
import earth_sciences_faculty
import design
import design_faculty
import mathematics
import mathematics_faculty
import physics_faculty
import queries
import rooms
import timeslots

DB_FILE = 'timetable.db'

print('deleting old database')
try:
    os.remove(DB_FILE)
except FileNotFoundError:
    pass

print('building schema')
with open('schema.sql') as schema:
    subprocess.run(['sqlite3', DB_FILE], stdin=schema, check=True)

print('building term and holidays')
db = queries.DB(DB_FILE)
db.make_term('Spring 2027', '2027-01-11', '2027-05-04')
db.make_holiday('2027-01-18')
db.make_holiday('2027-02-15')
db.make_holiday('2027-03-08')
db.make_holiday('2027-03-09')
db.make_holiday('2027-03-10')
db.make_holiday('2027-03-11')
db.make_holiday('2027-03-12')

try:
    courses.build_courses(db)
    rooms.build_rooms(db)
    timeslots.build_time_slots(db)
    computing.build_pre(db)
    computingfaculty.build_faculty(db)
    mathematics_faculty.build_faculty(db)
    physics_faculty.build_faculty(db)
    engineering_faculty.build_faculty(db)
    earth_sciences_faculty.build_faculty(db)
    design_faculty.build_faculty(db)
    biotechnology_faculty.build_faculty(db)
    biology_faculty.build_faculty(db)
    chemistry_faculty.build_faculty(db)
    computing.build_post(db)
    biology.build_programs(db)
    chemistry.build_programs(db)
    engineering.build_programs(db)
    earth_sciences.build_programs(db)
    design.build_programs(db)
    mathematics.build_programs(db)
    db.validate_shared_day_off_preferences()
    db.db.commit()
except (ValueError, IntegrityError) as error:
    db.rollback()
    raise SystemExit(f'input build failed: {error}') from None

db.db.execute('VACUUM')
db.db.execute('ANALYZE')
